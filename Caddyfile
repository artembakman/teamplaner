{
 email {$ACME_EMAIL}
}
{$DOMAIN} {
 encode zstd gzip
 request_body {
  max_size 1MB
 }
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy same-origin
  X-Frame-Options DENY
  Strict-Transport-Security "max-age=31536000"
 }
 reverse_proxy app:3000 {
  header_up X-Real-IP {remote_host}
 }
}
